{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "yue2-groove-pod",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "observability": { "enabled": true },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "none",
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [{ "name": "SESSIONS", "class_name": "Sessions" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Sessions"] }],
  "workflows": [
    { "name": "yue2-groove-pod-deploy", "binding": "DEPLOY", "class_name": "DeployWorkflow" }
  ],
  "triggers": { "crons": ["*/15 * * * *"] },
  "vars": {
    // The image built from yue2_groove/deploy/docker (GHCR, public): `latest` follows every
    // release tag (v0.9.0 → …); `main` was a one-off manual build and no longer moves.
    "IMAGE": "ghcr.io/deadjoe/yue2_groove:latest",
    // Selection rules: smallest card the app is validated on, price ceiling, cloud.
    "MIN_GPU_GB": "16",
    "MAX_PRICE_PER_HR": "0.60",
    "CLOUD": "SECURE",
    // Cost guard: the pod is deleted this many hours after launch unless stopped earlier.
    "DEFAULT_TTL_HOURS": "3",
    "MAX_TTL_HOURS": "8",
    // Per-pod disk for the image layers + 8 GB of weights.
    "CONTAINER_DISK_GB": "40"
  }
  // Secrets (wrangler secret put): RUNPOD_API_KEY (required), NOTIFY_URL (optional Bark or ntfy URL),
  // NOTIFY_TOKEN (ntfy access token; needed with ntfy.sh, see README),
  // LAUNCH_KEY (strongly advised; gates the page + API with a cookie set from /?k=<key>)
}
